NEXT_PUBLIC_SITE_URL=https://example.com

# Resend API key, used by the "Work with me" enquiry form to email both the
# visitor's verification code and the enquiry itself. Create one at
# https://resend.com/api-keys. The sending domain (the address in the email's
# "from") must be verified in Resend. In local `next dev` it can stay empty:
# both emails are printed to the server console instead.
RESEND_API_KEY=

# Upstash Redis credentials. Required in production: the enquiry form's email
# verification stores its codes and passes there, and the form refuses to send
# without it. Also rate-limits the form. In local `next dev` it can stay
# empty (an in-memory stand-in is used). Create a free database at
# https://console.upstash.com/.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Secret for the enquiry form's email verification (seals the emailed codes
# and names addresses in Redis). Required in production, at least 32 bytes.
# Generate one with `openssl rand -base64 32`. In local `next dev` it can stay
# empty (a built-in development value is used).
EMAIL_VERIFICATION_SECRET=

# GitHub classic PAT (repo + read:user scopes). Optional: the home page's
# contribution heatmap reads the public profile page and needs no token; this
# only serves as a fallback data source (GraphQL) if that markup ever changes.
# Create one at https://github.com/settings/tokens.
GITHUB_TOKEN=
